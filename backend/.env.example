# =================================================================
# AssistantMedixa / AssistanMedixa - Backend Environment Variables
# =================================================================

# Server & Project
PROJECT_NAME="AssistantMedixa - Agentic AI Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & JWT
SECRET_KEY="your_super_secret_jwt_key_here_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

#  Generative AI API
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL_NAME="gemini-2.0-flash"
GEMINI_STT_MODEL_NAME="gemini-2.0-flash"
MAX_AUDIO_UPLOAD_BYTES=26214400

# LangGraph Persistence
CHECKPOINT_DB_PATH="checkpoints.db"

# Qdrant Vector DB (Optional / Embedded)
QDRANT_HOST="localhost"
QDRANT_PORT=6333

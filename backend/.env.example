# AIMedical backend configuration
# Isi GEMINI_API_KEY dengan API key Google Gemini Anda sebelum menjalankan backend.
PROJECT_NAME=AIMedical - Agentic AI Platform
VERSION=1.0.0
API_V1_STR=/api/v1

# Authentication
SECRET_KEY=change-this-to-a-long-random-secret-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini (Primary & Automatic Fallback Models)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.8-flash
GEMINI_STT_MODEL_NAME=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-latest,gemini-flash-lite-latest

# Audio WAV upload limit (25 MB)
MAX_AUDIO_UPLOAD_BYTES=26214400

# SATUSEHAT Integration
SS_ENVIRONMENT=sandbox
SS_ORGANIZATION_ID=your_satusehat_organization_id
SS_ClIENT_ID=your_satusehat_client_id
SS_CLIENT_SECRET=your_satusehat_client_secret

# MongoDB Persistence
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=medixa
MONGODB_PASSWORD=admin2026
MONGODB_DATABASE=assistant_medixa
MONGODB_AUTH_SOURCE=assistant_medixa
MONGODB_URL=mongodb://medixa:admin2026@localhost:27017/assistant_medixa?authSource=assistant_medixa
